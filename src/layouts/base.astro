---
import OgImage from '~/assets/og.jpg'
import Icon from '~/components/svelte/icon.svelte'
import Navigation from '~/components/svelte/navigation.svelte'
import '~/assets/styles.css'

interface Props {
  description: string
  subtitle?: string
  title: string
}

const { description, subtitle, title } = Astro.props

const seoTitleSuffix = ' | Tejal Shinde'

const seoTitle = Astro.url.pathname.match(/^\/(?:index\.html)?$/)
  ? title
  : `${title}${seoTitleSuffix}`

const urlRegex = Astro.url.pathname.toLowerCase().match(
  // test: https://regex101.com/r/HVqakl/1
  /^\/(?<menu>about|contact|work)(?:\/(?<section>(?<=work\/)(advertising|fashion|presentations))\/?(?<project>[a-z-]+)?)?\/?(?:index\.html)?$/
)

const isProjectPage = Boolean(urlRegex?.groups?.['project'])

const isSectionPage = Boolean(urlRegex?.groups?.['section'] && !isProjectPage)

const isMenuPage = Boolean(
  urlRegex?.groups?.['menu'] && !isProjectPage && !isSectionPage
)

const jsonSchema: {
  '@context': 'https://schema.org/'
  '@graph': [
    {
      '@type': 'Website'
      name: 'Tejal Shinde'
      url: 'https://www.tejalshinde.com/'
    },
    {
      '@type': 'BreadcrumbList'
      itemListElement: Array<{
        '@type': 'ListItem'
        item: string
        name: string
        position: number
      } | null>
      name: 'Breadcrumbs'
    } | null
  ]
} = {
  '@context': 'https://schema.org/',
  '@graph': [
    {
      '@type': 'Website',
      name: 'Tejal Shinde',
      url: 'https://www.tejalshinde.com/'
    },
    isMenuPage || isProjectPage || isSectionPage
      ? {
          '@type': 'BreadcrumbList',
          itemListElement: [
            {
              '@type': 'ListItem',
              item: 'https://www.tejalshinde.com/',
              name: 'Tejal Shinde',
              position: 1
            },
            (() => {
              const menu = urlRegex?.groups?.['menu'] || ''
              return {
                '@type': 'ListItem',
                item: new URL(`/${menu}/`, 'https://www.tejalshinde.com/').href,
                name: `${menu.slice(0, 1).toUpperCase()}${menu.slice(1)}${seoTitleSuffix}`,
                position: 2
              }
            })(),
            isProjectPage || isSectionPage
              ? (() => {
                  const section = urlRegex?.groups?.['section'] || ''
                  return {
                    '@type': 'ListItem',
                    item: new URL(
                      `/work/${section}/`,
                      'https://www.tejalshinde.com/'
                    ).href,
                    name: `${section.slice(0, 1).toUpperCase()}${section.slice(1)}${seoTitleSuffix}`,
                    position: 3
                  }
                })()
              : null,
            isProjectPage
              ? {
                  '@type': 'ListItem',
                  item: Astro.url.href,
                  name: seoTitle,
                  position: 4
                }
              : null
          ],
          name: 'Breadcrumbs'
        }
      : null
  ]
}

const finalJsonSchema = {
  ...jsonSchema,
  '@graph': jsonSchema['@graph'].filter(Boolean).map((item) => {
    if (item?.['@type'] === 'BreadcrumbList') {
      return {
        ...item,
        itemListElement: item.itemListElement.filter(Boolean)
      }
    }
    return item
  })
}
---

<html class="min-h-full w-full" lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta content="Tejal Shinde" name="author"/>
    <meta content={description} name="description"/>
    <meta content={Astro.generator} name="generator"/>
    <meta content="initial-scale=1, width=device-width" name="viewport"/>
    <meta content={new URL(OgImage.src, Astro.url)} property="og:image"/>
    <meta content="Open Graph cover for Tejal Shinde's portfolio" property="og:image:alt"/>
    <meta content="630" property="og:image:height"/>
    <meta content="image/jpeg" property="og:image:type"/>
    <meta content="1200" property="og:image:width"/>
    <meta content={seoTitle} property="og:title"/>
    <meta content="website" property="og:type"/>
    <meta content={Astro.url} property="og:url"/>
    <title>{seoTitle}</title>
    <script is:inline set:html={JSON.stringify(finalJsonSchema)} type="application/ld+json"></script>
  </head>
  <body class="bg-light-500 dark:bg-dark-500 box-border font-montserrat m-0 min-h-full text-dark-500 dark:text-light-500 w-full">
    <header class="bg-light-500 dark:bg-dark-500 border-0 border-b-0.25 border-gray-300 dark:border-gray-500 border-solid box-border h-24 left-0 p-x-6 lg:p-x-32 md:p-x-16 pos-fixed top-0 w-full z-100">
      <div class="flex h-full items-center justify-between max-w-300 m-x-auto">
        <a class="decoration-none flex gap-x-3 items-center text-current" href="/">
          <Icon name="tejal" size={10}/>
          <span class="hidden md:block uppercase">Tejal Shinde</span>
        </a>
        <div class="flex gap-x-3 items-center">
          <Navigation client:load menu={urlRegex?.groups?.['menu']} section={urlRegex?.groups?.['section']}/>
        </div>
      </div>
    </header>
    <main class="box-border p-t-36 p-x-6 lg:p-x-32 md:p-x-16 w-full">
      <div class="m-x-auto max-w-300">
        {
          (isProjectPage || isSectionPage) &&
          <h2 class="font-400 m-0 text-9 text-center uppercase" class:list={[{'m-b-6': !subtitle}]}>{title}</h2>
        }
        {
          subtitle &&
          <p class="m-0 m-b-6 text-center">{subtitle}</p>
        }
        {
          (isProjectPage || isSectionPage) &&
          <p class="m-0 m-b-6 text-center">{description}</p>
        }
        <slot/>
      </div>
    </main>
  <footer class="m-b-6 m-t-12 text-center">&copy; 2024 Tejal Shinde</footer>
  </body>
</html>

<script>
  import { resizeMasonry } from '~/utils/functions.ts'

  let timeout: NodeJS.Timeout

  function windowResizeHandler() {
    const imgToResize = document.querySelectorAll('picture > img')
    const linksToRoundContainers = document.querySelectorAll<HTMLDivElement>('div.grid.grid-cols-1.overflow-hidden')
    const masonryToResize = document.querySelectorAll<HTMLDivElement>('[data-masonry]')
    const maxHeight = window.innerHeight * 0.8
    const mediaPlayersToResize = document.querySelectorAll('media-player')
    const recaptchaToResize = document.querySelectorAll('.g-recaptcha')
    const vw = document.documentElement.clientWidth

    for (const img of imgToResize) {
      const parentLevel = Number.parseInt(img.getAttribute('data-ro-parent') || '1')
      if (parentLevel > 0) {
        let parent = img as HTMLElement
        for (let i = 0; i < parentLevel; i++) {
          parent = parent.parentElement as HTMLElement
        }
        parent.style.maxWidth = `${Math.round((maxHeight / Number.parseInt(img.getAttribute('height') || '0')) * Number.parseInt(img.getAttribute('width') || '0'))}px`
      }
    }

    for (const container of linksToRoundContainers) {
      const borderRadius = '0.375rem'
      const linksToRound = container.querySelectorAll('a')

      for (const [index, link] of linksToRound.entries()) {
        link.style.removeProperty('border-radius')
        link.style.removeProperty('border-bottom-left-radius')
        link.style.removeProperty('border-bottom-right-radius')
        link.style.removeProperty('border-top-left-radius')
        link.style.removeProperty('border-top-right-radius')

        if (linksToRound.length === 1) {
          link.style.borderRadius = borderRadius
        } else if (linksToRound.length === 2) {
          if (index === 0) {
            if (vw < 640) {
              link.style.borderTopLeftRadius = borderRadius
              link.style.borderTopRightRadius = borderRadius
            } else {
              link.style.borderTopLeftRadius = borderRadius
              link.style.borderBottomLeftRadius = borderRadius
            }
          } else {
            if (vw < 640) {
              link.style.borderBottomLeftRadius = borderRadius
              link.style.borderBottomRightRadius = borderRadius
            } else {
              link.style.borderTopRightRadius = borderRadius
              link.style.borderBottomRightRadius = borderRadius
            }
          }
        } else if (linksToRound.length === 3) {
          if (index === 0) {
            if (vw < 640) {
              link.style.borderTopLeftRadius = borderRadius
              link.style.borderTopRightRadius = borderRadius
            } else if (vw < 1024 && vw > 640) {
              link.style.borderTopLeftRadius = borderRadius
            } else {
              link.style.borderTopLeftRadius = borderRadius
              link.style.borderBottomLeftRadius = borderRadius
            }
          } else if (index === 1) {
            if (vw < 1024 && vw >= 640) {
              link.style.borderBottomRightRadius = borderRadius
              link.style.borderTopRightRadius = borderRadius
            }
          } else {
            if (vw < 1024) {
              link.style.borderBottomLeftRadius = borderRadius
              link.style.borderBottomRightRadius = borderRadius
            } else {
              link.style.borderBottomRightRadius = borderRadius
              link.style.borderTopRightRadius = borderRadius
            }
          }
        } else {
          if (vw < 640) {
            if (index === 0) {
              link.style.borderTopLeftRadius = borderRadius
              link.style.borderTopRightRadius = borderRadius
            } else if (index === linksToRound.length - 1) {
              link.style.borderBottomLeftRadius = borderRadius
              link.style.borderBottomRightRadius = borderRadius
            }
          } else if (vw < 1024 && vw >= 640) {
            const remainder = linksToRound.length % 2

            if (index === 0) {
              link.style.borderTopLeftRadius = borderRadius
            } else if (index === 1) {
              link.style.borderTopRightRadius = borderRadius
            } else if (remainder === 0) {
              if (index === linksToRound.length - 2) {
                link.style.borderBottomLeftRadius = borderRadius
              } else if (index === linksToRound.length - 1) {
                link.style.borderBottomRightRadius = borderRadius
              }
            } else {
              if (index === linksToRound.length - 2) {
                link.style.borderBottomRightRadius = borderRadius
              } else if (index === linksToRound.length - 1) {
                link.style.borderBottomLeftRadius = borderRadius
                link.style.borderBottomRightRadius = borderRadius
              }
            }
          } else {
            const remainder = linksToRound.length % 3

            if (index === 0) {
              link.style.borderTopLeftRadius = borderRadius
            } else if (index === 2) {
              link.style.borderTopRightRadius = borderRadius
            } else if (remainder === 0) {
              if (index === linksToRound.length - 3) {
                link.style.borderBottomLeftRadius = borderRadius
              } else if (index === linksToRound.length - 1) {
                link.style.borderBottomRightRadius = borderRadius
              }
            } else if (remainder === 1) {
              if (index === linksToRound.length - 2) {
                link.style.borderBottomRightRadius = borderRadius
              } else if (index === linksToRound.length - 1) {
                link.style.borderBottomLeftRadius = borderRadius
                link.style.borderBottomRightRadius = borderRadius
              }
            } else if (remainder === 2) {
              if (index === linksToRound.length - 2) {
                link.style.borderBottomLeftRadius = borderRadius
              } else if (index === linksToRound.length - 1) {
                link.style.borderBottomRightRadius = borderRadius
              }
            }
          }
        }
      }
    }

    for (const masonry of masonryToResize) {
      resizeMasonry(masonry, vw)
    }

    for (const player of mediaPlayersToResize) {
      const computedStyles = getComputedStyle(player)
      const originalHeight = Number.parseInt(computedStyles.height)
      const originalWidth = Number.parseInt(computedStyles.width)
      if (originalHeight > originalWidth) {
        player.style.maxWidth = `${Math.round((maxHeight / originalHeight) * originalWidth)}px`
      }
    }

    for (const recaptcha of recaptchaToResize) {
      const parentDiv = recaptcha.parentElement as HTMLDivElement
      if (vw < 420) {
        parentDiv.classList.remove('m-y-6')
        parentDiv.classList.add('scale-75')
      } else {
        parentDiv.classList.remove('scale-75')
        parentDiv.classList.add('m-y-6')
      }
    }
  }

  window.addEventListener('resize', () => {
    clearTimeout(timeout)
    timeout = setTimeout(windowResizeHandler, 250)
  })

  window.rh = windowResizeHandler
  window.rh()
</script>
