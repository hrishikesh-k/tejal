---
import OgImage from '~/assets/og.jpg'
import Icon from '~/components/icon.astro'
import Navigation from '~/components/navigation.astro'
import { collectionList, url } from '~/utils/constants.ts'
import '~/assets/styles.css'

interface Props {
  cover?: string
  description: string
  subtitle?: string | undefined
  title: string
}

const { cover, description, subtitle, title } = Astro.props

const seoTitleSuffix = ' | Tejal Shinde'

const seoTitle = Astro.url.pathname.match(/^\/(?:index\.html)?$/)
  ? title
  : `${title}${seoTitleSuffix}`

const urlRegex = Astro.url.pathname.toLowerCase().match(
  // test: https://regex101.com/r/HVqakl/1
  /^\/(?<menu>about|contact|work)(?:\/(?<collection>(?<=work\/)(advertising|modelling|presentations|rajasab|the-amazing-fashion-magazine-issue-19))\/?(?<project>[a-z-]+)?)?\/?(?:index\.html)?$/
) as RegExpMatchArray & {
  groups?: {
    collection: (typeof collectionList)[number]['slug']
    menu: 'about' | 'contact' | 'work'
    project: string
  }
}

const collection = urlRegex?.groups?.collection as NonNullable<
  typeof urlRegex.groups
>['collection']
const menu = urlRegex?.groups?.menu as NonNullable<
  typeof urlRegex.groups
>['menu']
const isProjectPage = Boolean(urlRegex?.groups?.project)
const isCollectionPage = Boolean(collection && !isProjectPage)
const isMenuPage = Boolean(menu && !isProjectPage && !isCollectionPage)

const jsonSchema: {
  '@context': 'https://schema.org/'
  '@graph': [
    {
      '@type': 'Website'
      name: 'Tejal Shinde'
      url: typeof url
    },
    {
      '@type': 'BreadcrumbList'
      itemListElement: Array<{
        '@type': 'ListItem'
        item: string
        name: string
        position: number
      } | null>
      name: 'Breadcrumbs'
    } | null,
    {
      '@type': 'BlogPosting'
      author: {
        '@type': 'Person'
        name: 'Tejal Shinde'
        url: typeof url
      }
      description: string
      headline: string
      image: string
      mainEntityOfPage: {
        '@id': string
        '@type': 'WebPage'
      }
      url: typeof url
    } | null
  ]
} = {
  '@context': 'https://schema.org/',
  '@graph': [
    {
      '@type': 'Website',
      name: 'Tejal Shinde',
      url
    },
    isMenuPage || isProjectPage || isCollectionPage
      ? {
          '@type': 'BreadcrumbList',
          itemListElement: [
            {
              '@type': 'ListItem',
              item: url,
              name: 'Tejal Shinde',
              position: 1
            },
            (() => {
              return {
                '@type': 'ListItem',
                item: new URL(`/${menu}/`, url).href,
                name: `${menu.slice(0, 1).toUpperCase()}${menu.slice(1)}${seoTitleSuffix}`,
                position: 2
              }
            })(),
            isProjectPage || isCollectionPage
              ? (() => {
                  const collectionFromList = collectionList.find(
                    (collectionsEntry) => collectionsEntry.slug === collection
                  ) as (typeof collectionList)[number]
                  return {
                    '@type': 'ListItem',
                    item: new URL(`/work/${collectionFromList.slug}/`, url)
                      .href,
                    name: `${collectionFromList.title}${seoTitleSuffix}`,
                    position: 3
                  }
                })()
              : null,
            isProjectPage
              ? {
                  '@type': 'ListItem',
                  item: Astro.url.href,
                  name: seoTitle,
                  position: 4
                }
              : null
          ],
          name: 'Breadcrumbs'
        }
      : null,
    isProjectPage || collection === 'rajasab'
      ? {
          '@type': 'BlogPosting',
          author: {
            '@type': 'Person',
            name: 'Tejal Shinde',
            url
          },
          description,
          headline: seoTitle,
          image: `${url}${(cover || '').slice(1)}`,
          mainEntityOfPage: {
            '@id': Astro.url.href,
            '@type': 'WebPage'
          },
          url
        }
      : null
  ]
}

const finalJsonSchema = {
  ...jsonSchema,
  '@graph': jsonSchema['@graph'].filter(Boolean).map((item) => {
    if (item?.['@type'] === 'BreadcrumbList') {
      return {
        ...item,
        itemListElement: item.itemListElement.filter(Boolean)
      }
    }
    return item
  })
}
---

<html class="min-h-full w-full" lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta content="Tejal Shinde" name="author"/>
    <meta content={description} name="description"/>
    <meta content={Astro.generator} name="generator"/>
    <meta content="initial-scale=1, width=device-width" name="viewport"/>
    <meta content={new URL(OgImage.src, Astro.url)} property="og:image"/>
    <meta content="Open Graph cover for Tejal Shinde's portfolio" property="og:image:alt"/>
    <meta content="630" property="og:image:height"/>
    <meta content="image/jpeg" property="og:image:type"/>
    <meta content="1200" property="og:image:width"/>
    <meta content={seoTitle} property="og:title"/>
    <meta content="website" property="og:type"/>
    <meta content={Astro.url} property="og:url"/>
    <title>{seoTitle}</title>
    <script is:inline set:html={JSON.stringify(finalJsonSchema)} type="application/ld+json"></script>
  </head>
  <body class="bg-light-500 box-border font-montserrat m-0 min-h-full text-dark-500 w-full">
    <template id="media-chrome">
      <style>
        :host {
          --media-font-family: "Montserrat", sans-serif;
          --media-font-size: 0.75rem;
          --media-text-color: #1f1f1f;
          --media-time-range-hover-bottom: 0;
          --media-time-range-hover-height: 44px;
          --media-tooltip-arrow-display: none;
          --media-tooltip-background-color: #dde1e3;
          --media-tooltip-border-radius: 0.25rem;
          --media-tooltip-distance: 0.5rem;
          --media-tooltip-padding: 0.5rem;
        }
        .fill-current {
          fill: currentColor;
        }
        .flex-grow-1 {
          flex-grow: 1;
        }
        .h-4 {
          height: 1rem;
        }
        .overflow-visible {
          overflow: visible;
        }
        .text-light-500 {
          color: #f2f2f2;
        }
      </style>
      <template partial="fullscreen">
        <media-fullscreen-button class="text-light-500">
          <span class="h-4" slot="enter">
            <Icon name="expand"/>
          </span>
          <span class="h-4" slot="exit">
            <Icon name="compress"/>
          </span>
        </media-fullscreen-button>
      </template>
      <template partial="menu"></template>
      <template partial="mute">
        <media-mute-button class="text-light-500">
          <span class="h-4" slot="high">
            <Icon name="volume-high"/>
          </span>
          <span class="h-4" slot="medium">
            <Icon name="volume"/>
          </span>
          <span class="h-4" slot="low">
            <Icon name="volume-low"/>
          </span>
          <span class="h-4" slot="off">
            <Icon name="volume-xmark"/>
          </span>
        </media-mute-button>
      </template>
      <template partial="pip">
        <media-pip-button class="text-light-500">
          <span class="h-4" slot="enter">
            <Icon name="picture-in-picture"/>
          </span>
          <span class="h-4" slot="exit">Exit</span> <!-- TODO: PiP exit button -->
        </media-pip-button>
      </template>
      <template partial="play">
        <media-play-button class="text-light-500">
          <span class="h-4" slot="play">
            <Icon name="play"/>
          </span>
          <span class="h-4" slot="pause">
            <Icon name="pause"/>
          </span>
        </media-play-button>
      </template>
      <template partial="settings">
        <media-settings-menu-button class="text-light-500">
          <span class="h-4" slot="icon">
            <Icon name="gear"/>
          </span>
        </media-settings-menu-button>
      </template>
      <media-controller autohideovercontrols breakpoints="md:768 lg:1024 sm:640 xl:1280 xs:320" class="border-rounded-1.5" defaultstreamtype="on-demand">
        <hls-video slot="media">
          <track default kind="metadata" label="thumbnails">
        </hls-video>
        <media-poster-image slot="poster"></media-poster-image>
        <media-settings-menu hidden anchor="auto" class="border-tl-rounded-1.5">
          <media-settings-menu-item>
            <span>Speed</span>
            <media-playback-rate-menu hidden slot="submenu">
              <span slot="title">Speed</span>
            </media-playback-rate-menu>
          </media-settings-menu-item>
          <media-settings-menu-item>
            <span>Quality</span>
            <media-rendition-menu hidden slot="submenu">
              <span slot="title">Quality</span>
            </media-rendition-menu>
          </media-settings-menu-item>
        </media-settings-menu>
        <template if="!breakpointsm">
          <media-control-bar slot="top-chrome">
            <Fragment set:text={'{{>mute}}'}/>
            <span class="flex-grow-1"></span>
            <Fragment set:text={'{{>fullscreen}}'}/>
            <Fragment set:text={'{{>pip}}'}/>
          </media-control-bar>
          <media-control-bar>
            <Fragment set:text={'{{>play}}'}/>
            <media-time-range class="text-light-500"></media-time-range>
            <Fragment set:text={'{{>settings}}'}/>
          </media-control-bar>
        </template>
        <template if="breakpointsm">
          <media-control-bar>
            <Fragment set:text={'{{>play}}'}/>
            <Fragment set:text={'{{>mute}}'}/>
            <media-volume-range></media-volume-range>
            <media-time-display showduration class="text-light-500"></media-time-display>
            <media-time-range class="text-light-500"></media-time-range>
            <Fragment set:text={'{{>fullscreen}}'}/>
            <Fragment set:text={'{{>pip}}'}/>
            <Fragment set:text={'{{>settings}}'}/>
          </media-control-bar>
        </template>
      </media-controller>
    </template>
    <header class="bg-light-500 border-0 border-b-0.25 border-gray-300 border-solid box-border h-24 left-0 p-x-6 lg:p-x-32 md:p-x-16 pos-fixed top-0 w-full z-100">
      <div class="flex h-full items-center justify-between max-w-300 m-x-auto">
        <a aria-label="homepage" class="decoration-none flex gap-x-3 items-center text-current" href="/">
          <Icon name="tejal" size={10}/>
          <span class="hidden md:block uppercase">Tejal Shinde</span>
        </a>
        <div class="flex gap-x-3 items-center">
          <Navigation collection={collection} menu={menu}/>
        </div>
      </div>
    </header>
    <main class="box-border p-t-36 p-x-6 lg:p-x-32 md:p-x-16 w-full">
      <div class="m-x-auto max-w-300">
        {
          (isProjectPage || isCollectionPage) &&
          <h2 class="font-400 m-0 text-9 text-center uppercase" class:list={[{'m-b-6': !subtitle}]}>{title}</h2>
        }
        {
          subtitle &&
          <p class="m-0 m-b-6 text-center">{subtitle}</p>
        }
        {
          (isProjectPage || isCollectionPage) &&
          <p class="m-0 m-b-6 text-center">{description}</p>
        }
        <slot/>
      </div>
    </main>
  <footer class="m-b-6 m-t-12 text-center">&copy; {new Date().getFullYear()} Tejal Shinde</footer>
  </body>
</html>

<script>
import { addWindowBeforeUnloadEventHandler } from '~/utils/components/video.ts'
import { addWindowResizeEventHandler } from '~/utils/functions.ts'
addWindowBeforeUnloadEventHandler()
addWindowResizeEventHandler()
</script>
