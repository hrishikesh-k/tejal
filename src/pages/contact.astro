---
import Textfield from '~/components/textfield.astro'
import Turnstile from '~/components/turnstile.astro'
import Base from '~/layouts/base.astro'
import { formInputClass, formSpanClass } from '~/utils/constants.ts'
---

<Base description="Connect with Tejal Shinde for collaborations, inquiries or bookings, or to bring your creative vision to life!" title="Contact">
  <div class="flex flex-wrap gap-6">
    <astro-contact class="flex flex-col">
      <form action="/contact/" class="flex md:flex-basis-0 flex-col md:flex-grow-1 md:flex-shrink-1 xs:gap-y-4 children:transition-duration-500 children:transition-opacity max-w-full" method="post" name="contact">
        <input type="hidden" name="form-name" value="contact">
        <div class="flex gap-x-2 items-center">
          <Textfield flex label="First name"/>
          <Textfield flex label="Last name"/>
        </div>
        <Textfield label="E-mail" type="email"/>
        <Textfield label="Subject"/>
        <label class="block pos-relative">
          <textarea class="min-h-36 resize-none" class:list={formInputClass} name="message" placeholder="&nbsp;" required></textarea>
          <span class:list={formSpanClass}>Message</span>
        </label>
        <Turnstile/>
        <button class="bg-dark-500 hover:bg-dark-900 border-0 border-rounded-1 cursor-pointer font-montserrat p-2 text-4 text-light-500 w-fit" type="submit">Submit</button>
      </form>
    </astro-contact>
    <iframe allowfullscreen class="border-0 border-rounded-1.5 md:flex-basis-0 md:flex-grow-1 md:flex-shrink-1 w-full md:w-auto" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d193595.91597692392!2d-74.1201062451659!3d40.6974030270224!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c24fa5d33f083b%3A0xc80b8f06e177fe62!2sNew%20York%2C%20NY%2C%20USA!5e0!3m2!1sen!2sin!4v1680813812771!5m2!1sen!2sin" title="map"></iframe>
  </div>
</Base>

<script>
import { AstroContact } from '~/utils/components/contact.ts'
customElements.define('astro-contact', AstroContact)
</script>
