---
import Textfield from '~/components/textfield.astro'
import Turnstile from '~/components/turnstile.astro'
import Base from '~/layouts/base.astro'
---

<Base description="You're not authorized to access the requested resource." title="Password">
  <astro-password class="flex justify-center">
    <form action="/" class="flex flex-col xs:gap-y-3 max-w-75 w-full" data-reload="true" method="post" name="password">
      <input type="hidden" name="form-name" value="password">
      <Textfield label="Password" type="password"/>
      <Turnstile/>
      <button class="bg-dark-500 hover:bg-dark-900 border-0 border-rounded-1 cursor-pointer font-montserrat p-2 text-4 text-light-500" type="submit">Submit</button>
    </form>
  </astro-password>
</Base>

<script>
import { AstroPassword } from '~/utils/components/password.ts'
customElements.define('astro-password', AstroPassword)
</script>
