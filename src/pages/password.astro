---
import type { Env } from '~/env.d.ts'
import Base from '~/layouts/base.astro'
import { formInputClass, formSpanClass } from '~/utils/constants/server.ts'
---

<Base description="You're not authorized to access the requested resource." title="Password">
  <astro-password class="flex justify-center">
    <form action="/" class="flex flex-col xs:gap-y-3 max-w-75 w-full" method="post" name="password">
      <input type="hidden" name="form-name" value="password">
      <label class="block pos-relative w-full">
        <input class:list={formInputClass} name="password" placeholder="&nbsp;" required type="password">
        <span class:list={formSpanClass}>Password</span>
      </label>
      <div class="flex-basis-0 flex-grow-1 flex-shrink-1 transform transform-origin-left transition-duration-250 transition-transform w-fit">
        <div class="cf-turnstile h-16" data-sitekey={(import.meta.env as Env).PUBLIC_TURNSTILE_SITE_KEY} data-theme="light"></div>
      </div>
      <button class="bg-dark-500 hover:bg-dark-900 border-0 border-rounded-1 cursor-pointer font-montserrat p-2 text-4 text-light-500" type="submit">Submit</button>
    </form>
  </astro-password>
</Base>

<script>
import { AstroPassword } from '~/utils/components/password.ts'
customElements.define('astro-password', AstroPassword)
</script>
