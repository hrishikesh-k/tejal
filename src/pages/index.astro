---
import Picture from '~/components/astro/picture.astro'
import Section from '~/components/astro/section.astro'
import Swiper from '~/components/svelte/swiper.svelte'
import {
  advertisingPosts,
  issue19Posts,
  modellingPosts,
  presentationPosts
} from '~/content/posts.ts'
import Base from '~/layouts/base.astro'
import Heading3 from '../components/astro/heading3.astro'
---

<Base description="Explore the creative world of Tejal Shinde - a versatile Art Director and Fashion Model through her captivating online portfolio." title="Tejal Shinde">
    <Heading3 noMarginTop text="The Amazing Fashion Magazine (Issue 19)"/>
    <Swiper client:load>
      {
        issue19Posts.map((post) => (
          <swiper-slide>
            <a href={`/work/the-amazing-fashion-magazine-issue-19/${post.id}/`}>
              <Picture alt={`cover art for ${post.data.title}`} height={post.data.cover.height} rounded src={post.data.cover.src} width={post.data.cover.width}/>
            </a>
          </swiper-slide>
        ))
      }
    </Swiper>
  <Section explore posts={advertisingPosts.slice(0, 3)} showTitle title="Advertising"/>
  <Section explore posts={modellingPosts.slice(0, 3)} showTitle title="Modelling"/>
  <Section explore posts={presentationPosts.slice(0, 3)} showTitle title="Presentations"/>
</Base>
