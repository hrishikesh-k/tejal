---
import Section from '~/components/astro/section.astro'
import {
  advertisingPosts,
  fashionPosts,
  presentationPosts
} from '~/content/posts.ts'
import Base from '~/layouts/base.astro'
---

<Base description="Explore the creative world of Tejal Shinde - a versatile Art Director and Fashion Model through her captivating online portfolio." title="Tejal Shinde">
  <Section noTitleMarginTop explore posts={advertisingPosts.slice(0, 3)} showTitle title="Advertising"/>
  <Section explore posts={fashionPosts.slice(0, 3)} showTitle title="Fashion"/>
  <Section explore posts={presentationPosts.slice(0, 3)} showTitle title="Presentations"/>
</Base>
