---
import Collection from '~/components/collection.astro'
import Explore from '~/components/explore.astro'
import Base from '~/layouts/base.astro'
import {
  advertisingPosts,
  modellingPosts,
  presentationPosts,
  theAmazingFashionMagazineIssue19Posts
} from '~/utils/constants/server.ts'
---

<Base description="Explore the creative world of Tejal Shinde - a versatile Art Director and Fashion Model through her captivating online portfolio." title="Tejal Shinde">
  <Explore collection="the-amazing-fashion-magazine-issue-19" heading="The Amazing Fashion Magazine (Issue 19)" noHeadingMargin posts={theAmazingFashionMagazineIssue19Posts}/>
  <Collection explore posts={advertisingPosts.slice(0, 3)} showTitle title="Advertising"/>
  <Collection explore posts={presentationPosts.slice(0, 3)} showTitle title="Presentations"/>
  <Collection explore posts={modellingPosts.slice(0, 3)} showTitle title="Modelling"/>
</Base>
