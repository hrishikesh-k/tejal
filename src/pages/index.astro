---
import Section from '~/components/astro/section.astro'
import {
  advertisingPosts,
  fashionPosts,
  presentationPosts
} from '~/content/posts.ts'
import Base from '~/layouts/base.astro'
---

<Base title="Tejal Shinde">
  <Section explore posts={advertisingPosts.slice(0, 3)} title="Advertising"/>
  <Section explore posts={fashionPosts.slice(0, 3)} title="Fashion"/>
  <Section explore posts={presentationPosts.slice(0, 3)} title="Presentations"/>
</Base>
