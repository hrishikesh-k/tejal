---
import { type getCollection, render } from 'astro:content'
import { modellingPosts } from '~/content/posts.ts'
import Base from '~/layouts/base.astro'
import Explore from '../../../components/astro/explore.astro'

interface Props {
  post: Awaited<ReturnType<typeof getCollection<'modelling'>>>[number]
}

export async function getStaticPaths() {
  return modellingPosts.map((post) => ({
    params: {
      id: post.id
    },
    props: {
      post
    }
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<Base cover={post.data.cover.src} description={post.data.description} title={post.data.title}>
  <Content/>
  <Explore collection="modelling" heading="Explore further in Modelling" exclude={Astro.params.id} posts={modellingPosts}/>
</Base>
