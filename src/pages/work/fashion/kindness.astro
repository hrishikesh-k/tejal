---
import { getEntry } from 'astro:content'
import Masonry from '~/components/astro/masonry.astro'
import Picture from '~/components/astro/picture.astro'
import Base from '~/layouts/base.astro'
import { findAsset } from '~/utils/functions.ts'

const post = await getEntry('fashion', 'kindness')

const kindnesss = [
  findAsset(post, 'kindness-1'),
  findAsset(post, 'kindness-2'),
  findAsset(post, 'kindness-3'),
  findAsset(post, 'kindness-4'),
  findAsset(post, 'kindness-5')
]
---

<Base cover={post.data.cover.src} description={post.data.description} title={post.data.title}>
  <p class="m-0 m-b-6">Kindness can be likened to gold in the sense that it holds immense value in human interactions and relationships. Like gold, kindness is precious and enduring. It doesn't tarnish over time, instead, it shines brightly, leaving a lasting impression. People often cherish acts of kindness much like they treasure gold.</p>
  <Masonry>
    {
      kindnesss.map((kindness) => <Picture alt={kindness.alt} height={kindness.img.height} rounded src={kindness.img.src} width={kindness.img.width}/>)
    }
  </Masonry>
</Base>
