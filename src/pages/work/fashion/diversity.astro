---
import { getEntry } from 'astro:content'
import Masonry from '~/components/astro/masonry.astro'
import Picture from '~/components/astro/picture.astro'
import Base from '~/layouts/base.astro'
import { findAsset } from '~/utils/functions.ts'

const post = await getEntry('fashion', 'diversity')

const diversitys = [
  findAsset(post, 'diversity-1'),
  findAsset(post, 'diversity-2'),
  findAsset(post, 'diversity-3'),
  findAsset(post, 'diversity-4'),
  findAsset(post, 'diversity-5')
]
---

<Base description={post.data.description} title={post.data.title}>
  <Masonry>
    {
      diversitys.map((diversity) => <Picture alt={diversity.alt} height={diversity.img.height} rounded src={diversity.img.src} width={diversity.img.width}/>)
    }
  </Masonry>
</Base>
