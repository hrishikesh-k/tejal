    {
      pages.map((page) => (
        <div class="swiper-slide">
          <Picture alt={page.alt} height={page.img.height} src={page.img.src} width={page.img.width}/>
        </div>
      ))
    }
  </Swiper>
  <Tafm heading="Explore others" noExplore/>
</Base>
