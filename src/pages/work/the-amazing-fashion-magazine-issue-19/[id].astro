---
import { type getCollection, render } from 'astro:content'
import Explore from '~/components/explore.astro'
import Base from '~/layouts/base.astro'
import { theAmazingFashionMagazineIssue19Posts } from '~/utils/constants.ts'

interface Props {
  post: Awaited<
    ReturnType<typeof getCollection<'theAmazingFashionMagazineIssue19'>>
  >[number]
}

export async function getStaticPaths() {
  return theAmazingFashionMagazineIssue19Posts.map((post) => ({
    params: {
      id: post.id
    },
    props: {
      post
    }
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<Base cover={post.data.cover.src} description="Art & Design Director: Tejal Shinde" title={post.data.title}>
  <Content/>
  <Explore collection="the-amazing-fashion-magazine-issue-19" exclude={post.id} heading="Explore further in TAFM #19" posts={theAmazingFashionMagazineIssue19Posts}/>
</Base>
