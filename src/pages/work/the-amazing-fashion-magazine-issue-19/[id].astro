---
import { getCollection, render } from 'astro:content'
import Tafm from '~/components/astro/tafm.astro'
import Base from '~/layouts/base.astro'

export async function getStaticPaths() {
  const posts = await getCollection('issue19')
  return posts.map((post) => ({
    params: {
      id: post.id
    },
    props: {
      post
    }
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<Base cover={post.data.cover.src} description="Art & Design Director: Tejal Shinde" title={post.data.title}>
  <Content/>
  <Tafm exclude={post.id} heading="Explore others"/>
</Base>
