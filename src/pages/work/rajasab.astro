---

<Base cover={cover.src} description="Revitalized RAJASAB brand with striking identity, cohesive design, strategic content, and campaigns that drove national awareness and growth." title="Rajasab">
  <Heading3 text="Old website"/>
  <Masonry max={2}>
    {
      oldWebsite.map((screenshot) => <Picture alt={screenshot.alt} height={screenshot.img.height} rounded src={screenshot.img.src} width={screenshot.img.width}/>)
    }
  </Masonry>
  <Heading3 text="New website"/>
  <Video duration={41} qualities={{
    '144': vid1Segments144p,
    '240': vid1Segments240p,
    '360': vid1Segments360p,
    '480': vid1Segments480p,
    '720': vid1Segments720p,
    '1080': vid1Segments1080p,
    '1440': vid1Segments1440p
  }} poster={vid1Poster.src} thumbs={vid1Thumbs.src}/>
  <Heading3 text="Lookbook"/>
  <Swiper effect="fade">
    {
      lookbookPages.map((page) => (
        <div class="swiper-slide">
          <Picture alt={page.alt} height={page.img.height} src={page.img.src} width={page.img.width}/>
        </div>
      ))
    }
  </Swiper>
</Base>
