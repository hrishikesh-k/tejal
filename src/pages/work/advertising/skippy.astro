---
import { getEntry } from 'astro:content'
import vid1Poster from '~/assets/skippy/video-1/poster.jpg'
import vid1Thumbs from '~/assets/skippy/video-1/thumbs.jpg'
import vid2Poster from '~/assets/skippy/video-2/poster.jpg'
import vid2Thumbs from '~/assets/skippy/video-2/thumbs.jpg'
import Heading3 from '~/components/astro/heading3.astro'
import Picture from '~/components/astro/picture.astro'
import Swiper from '~/components/svelte/swiper.svelte'
import Video from '~/components/svelte/video.svelte'
import Base from '~/layouts/base.astro'
import { findAsset } from '~/utils/functions.ts'

const post = await getEntry('advertising', 'skippy')

const filters = [
  findAsset(post, 'filter-1'),
  findAsset(post, 'filter-2'),
  findAsset(post, 'filter-3'),
  findAsset(post, 'filter-4'),
  findAsset(post, 'filter-5')
]

const frame = findAsset(post, 'frame')

const tweets = [
  findAsset(post, 'tweet-1'),
  findAsset(post, 'tweet-2'),
  findAsset(post, 'tweet-3'),
  findAsset(post, 'tweet-4'),
  findAsset(post, 'tweet-5'),
  findAsset(post, 'tweet-6')
]

const vid1Segments144p = Object.values(
  import.meta.glob<string>('~/assets/skippy/video-1/144p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid1Segments240p = Object.values(
  import.meta.glob<string>('~/assets/skippy/video-1/240p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid1Segments360p = Object.values(
  import.meta.glob<string>('~/assets/skippy/video-1/360p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid1Segments480p = Object.values(
  import.meta.glob<string>('~/assets/skippy/video-1/480p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid1Segments720p = Object.values(
  import.meta.glob<string>('~/assets/skippy/video-1/720p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid1Segments1080p = Object.values(
  import.meta.glob<string>('~/assets/skippy/video-1/1080p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid2Segments144p = Object.values(
  import.meta.glob<string>('~/assets/skippy/video-2/144p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid2Segments240p = Object.values(
  import.meta.glob<string>('~/assets/skippy/video-2/240p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid2Segments360p = Object.values(
  import.meta.glob<string>('~/assets/skippy/video-2/360p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid2Segments480p = Object.values(
  import.meta.glob<string>('~/assets/skippy/video-2/480p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid2Segments720p = Object.values(
  import.meta.glob<string>('~/assets/skippy/video-2/720p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid2Segments1080p = Object.values(
  import.meta.glob<string>('~/assets/skippy/video-2/1080p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)
---

<Base cover={post.data.cover.src} description={post.data.description} title={post.data.title}>
  <Heading3 text="Tweets"/>
  <p class="m-0 m-b-6">A focus on highlighting Key Selling Points of Skippy's Peanut Butter through the copy. These USPs include smoothness, high protein content as well as being creamy.</p>
  <Swiper client:load>
    {
      tweets.map((tweet) => (
        <swiper-slide>
          <Picture alt={tweet.alt} height={tweet.img.height} parent={2} rounded src={tweet.img.src} width={tweet.img.width}/>
        </swiper-slide>
      ))
    }
  </Swiper>
  <Heading3 text="Filters"/>
  <p class="m-0 m-b-6">User-generated content on platforms like Instagram and Snapchat, particularly through engaging AR filters, has immense sharing potential. When users share these interactive filters with friends, it creates a ripple effect. Friends who see them are likely to use and share the filters, leading to an expansive reach. Hootsuite reports that consumers view user-generated content as 2.4 times more authentic than brand-created content, enhancing Skippy's credibility and engagement.</p>
  <div class="pos-relative">
    <Swiper center client:load>
      {
        filters.map((filter) => (
          <swiper-slide>
            <Picture alt={filter.alt} height={filter.img.height} parent={0} rounded src={filter.img.src} width={filter.img.width}/>
          </swiper-slide>
        ))
      }
    </Swiper>
    <div class="pointer-none pos-absolute top-0 w-full">
      <Swiper center client:load noNavigation>
        <swiper-slide>
          <Picture alt={frame.alt} height={frame.img.height} parent={0} rounded src={frame.img.src} width={frame.img.width}/>
        </swiper-slide>
      </Swiper>
    </div>
  </div>
  <Heading3 text="Games"/>
  <p class="m-0 m-b-6">Play the videos:</p>
  <div class="flex flex-wrap gap-6 items-center justify-center">
    <Video client:load duration={21} qualities={{
      '144': vid1Segments144p,
      '240': vid1Segments240p,
      '360': vid1Segments360p,
      '480': vid1Segments480p,
      '720': vid1Segments720p,
      '1080': vid1Segments1080p
    }} poster={vid1Poster.src} thumbs={vid1Thumbs.src} vertical/>
    <Video client:load duration={20} qualities={{
      '144': vid2Segments144p,
      '240': vid2Segments240p,
      '360': vid2Segments360p,
      '480': vid2Segments480p,
      '720': vid2Segments720p,
      '1080': vid2Segments1080p
    }} poster={vid2Poster.src} thumbs={vid2Thumbs.src} vertical/>
  </div>
</Base>
