---
import { type getCollection, render } from 'astro:content'
import Explore from '~/components/explore.astro'
import Base from '~/layouts/base.astro'
import { advertisingPosts } from '~/utils/constants.ts'

interface Props {
  post: Awaited<ReturnType<typeof getCollection<'advertising'>>>[number]
}

export async function getStaticPaths() {
  return advertisingPosts.map((post) => ({
    params: {
      id: post.id
    },
    props: {
      post
    }
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<Base cover={post.data.cover.src} description={post.data.description} subtitle={post.data.subtitle} title={post.data.title}>
  <Content/>
  <Explore collection="advertising" heading="Explore further in Advertising" exclude={Astro.params.id} posts={advertisingPosts}/>
</Base>
