---
import { getEntry } from 'astro:content'
import Picture from '~/components/astro/picture.astro'
import Base from '~/layouts/base.astro'
import { findAsset } from '~/utils/functions.ts'

const post = (await getEntry('advertising', 'pirelli')) as ReturnType<
  typeof getEntry
>

const mockups = [findAsset(post, 'mockup-1'), findAsset(post, 'mockup-2')]
---

<Base cover={post.data.cover.src} description={post.data.description} title={post.data.title}>
  <div class="flex flex-col gap-y-6 items-center m-y-6">
    {
      mockups.map((mockup) => <Picture alt={mockup.alt} height={mockup.img.height} rounded src={mockup.img.src} width={mockup.img.width}/>)
    }
  </div>
</Base>
