---
import { getEntry } from 'astro:content'
import Picture from '~/components/astro/picture.astro'
import Base from '~/layouts/base.astro'
import { findAsset } from '~/utils/functions.ts'

const post = await getEntry('advertising', 'bombae-bantai-brewery')

const mockup3 = findAsset(post, 'mockup-3')
---

<Base description={post.data.description} subtitle={post.data.subtitle as string} title={post.data.title}>
  <Picture alt={mockup3.alt} height={mockup3.img.height} rounded src={mockup3.img.src} width={mockup3.img.width}/>
</Base>
