---
import Collection from '~/components/astro/collection.astro'
import Tafm from '~/components/astro/tafm.astro'
import {
  advertisingPosts,
  modellingPosts,
  presentationPosts
} from '~/content/posts.ts'
import Base from '~/layouts/base.astro'
---

<Base description="Browse through Tejal Shinde's breathtaking portfolio, showcasing her diverse range of captivating projects and creative endeavours." title="Work">
  <Tafm noHeadingMargin/>
  <Collection noTitleMarginTop posts={advertisingPosts} showTitle title="Advertising"/>
  <Collection posts={modellingPosts} showTitle title="Modelling"/>
  <Collection posts={presentationPosts} showTitle title="Presentations"/>
</Base>
