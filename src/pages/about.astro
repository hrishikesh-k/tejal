---
import about from '~/assets/about/about.jpg'
import resume from '~/assets/about/resume.pdf?url'
import vid1Manifest from '~/assets/about/video-1/manifest.m3u8?raw'
import vid1Poster from '~/assets/about/video-1/poster.jpg'
import vid1ThumbsJpg from '~/assets/about/video-1/thumbs.jpg'
import vid1ThumbsVtt from '~/assets/about/video-1/thumbs.vtt?raw'
import Picture from '~/components/astro/picture.astro'
import Tooltip from '~/components/svelte/tooltip.svelte'
import Video from '~/components/svelte/video.svelte'
import Base from '~/layouts/base.astro'

const vid1Segments144p = Object.values(
  import.meta.glob<string>('~/assets/about/video-1/144p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid1Segments240p = Object.values(
  import.meta.glob<string>('~/assets/about/video-1/240p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid1Segments360p = Object.values(
  import.meta.glob<string>('~/assets/about/video-1/360p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid1Segments480p = Object.values(
  import.meta.glob<string>('~/assets/about/video-1/480p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid1Segments720p = Object.values(
  import.meta.glob<string>('~/assets/about/video-1/720p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)

const vid1Segments1080p = Object.values(
  import.meta.glob<string>('~/assets/about/video-1/1080p/*.m3u8seg', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)
---

<Base title="About">
  <div class="flex flex-wrap gap-9 lg:gap-12 xl:gap-18 items-center justify-center m-b-12 pos-relative">
    <div class="flex-basis-0 flex-grow-1 flex-shrink-1">
      <Picture alt="Tejal Shinde" height={about.height} parent={2} rounded src={about.src} width={about.width}/>
    </div>
    <div class="lg:flex-basis-0 lg:flex-grow-1 lg:flex-shrink-1">
      <h2 class="font-400 m-0 text-9 text-center uppercase">Tejal Shinde</h2>
      <p class="leading-8 md:leading-5 xl:leading-8 m-0 m-b-9 m-t-6">Art is not just what I do; it's who I am.<br/>My journey in advertising has been fueled by a passion for creativity and a commitment to addressing societal issues through impactful campaigns. With an academic background in advertising and a knack for problem-solving, I believe I bring a unique perspective to the table.<br/>I don't just think outside the box; I live outside it.<br/><br/>As the strongest believer in kindness, I prioritize compassion, empathy and respect in every aspect of my life. I firmly believe that kindness not only enriches relationships but also fosters positive environments where individuals can thrive. Whether in personal interactions or professional settings, I strive to embody kindness as a guiding principle, recognizing its power to create meaningful connections and contribute to a more harmonious world.</p>
      <div class="flex gap-x-4 items-center justify-center">
        {
          [
            {
              href: 'https://www.facebook.com/tejal.shinde.9/',
              icon: 'square-facebook',
              text: 'Facebook'
            },
            {
              href: 'https://www.instagram.com/thebubblebreaker/',
              icon: 'square-instagram',
              text: 'Instagram'
            },
            {
              href: 'https://www.linkedin.com/in/tejal-shinde/',
              icon: 'linkedin',
              text: 'LinkedIn'
            },
            {
              href: 'mailto:shindevtejal@gmail.com',
              icon: 'square-envelope',
              text: 'E-mail'
            },
            {
              download: '[Tejal Shinde] - Resume.pdf',
              href: resume,
              icon: 'file-user',
              text: 'Résumé'
            }
          ].map(link => (
            <a class="text-current" download={link.download} href={link.href} rel="nofollow noopener noreffer" target="_blank">
              <Tooltip client:load icon={link.icon} text={link.text}/>
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <Video client:load manifest={vid1Manifest} qualities={{
    '144': vid1Segments144p,
    '240': vid1Segments240p,
    '360': vid1Segments360p,
    '480': vid1Segments480p,
    '720': vid1Segments720p,
    '1080': vid1Segments1080p,
  }} poster={vid1Poster.src} thumbs={{
    src: vid1ThumbsJpg.src,
    manifest: vid1ThumbsVtt
  }}/>
</Base>
