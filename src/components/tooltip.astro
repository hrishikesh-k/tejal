---
import Icon from '~/components/icon.astro'
import type { icons } from '~/utils/constants.ts'

interface Props {
  customBgP?: string
  icon: keyof typeof icons
  size?: 5 | 8
  text: string
}

const { customBgP, icon, size, text } = Astro.props
---

<button class="block border-0 border-rounded-1.5 box-border cursor-pointer outline-0 pos-relative text-current" class:list={[customBgP ?? 'bg-light-900 p-2']} is="astro-tooltip">
  <Icon name={icon} size={size}/>
  <span class="bg-light-900 border-rounded-1 box-border hidden p-2 pointer-none pos-absolute text-3 text-center text-current">{text}</span>
</button>

<script>
import { AstroTooltip } from '~/utils/components/tooltip.ts'
customElements.define('astro-tooltip', AstroTooltip, {
  extends: 'button'
})
</script>
