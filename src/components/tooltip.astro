---
import Icon from '~/components/icon.astro'
import type { icons } from '~/utils/constants.ts'

interface Props {
  icon: keyof typeof icons
  size?: 5 | 8 | undefined
  text: string
}

const { icon, size, text } = Astro.props
---

<astro-tooltip class="block border-0 border-rounded-1.5 box-border cursor-pointer outline-0 pos-relative text-current" class:list={
  [
    {
      'bg-light-900 p-2': size === 5
    },
    {
      'bg-transparent p-0': size === 8
    }
  ]
}>
  <Icon name={icon} size={size}/>
  <span class="bg-light-900 border-rounded-1 box-border hidden p-2 pointer-none pos-absolute text-3 text-center text-current">{text}</span>
</astro-tooltip>

<script>
import { AstroTooltip } from '~/utils/components/tooltip.ts'
customElements.define('astro-tooltip', AstroTooltip, {
  extends: 'button'
})
</script>
