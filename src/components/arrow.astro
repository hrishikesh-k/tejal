---
import Icon from '~/components/icon.astro'

interface Props {
  href: string
  text?: string
}

const { href, text } = Astro.props
---

<a class="after:bg-current after:border-rounded-0.25 after:bottom--2 after:content decoration-none flex gap-x-2 after:h-0.5 items-center after:left-0 m-l-auto m-t-6 pos-relative after:pos-absolute text-4 text-current md:text-6 after:transition-duration-250 after:transition-width w-fit after:w-0 after:hover:w-full" {href}>
  <span>{text || 'Explore all'}</span>
  <Icon name="circle-arrow-right" size={6}/>
</a>
