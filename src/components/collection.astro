---
import presentationSkippy from '~/assets/skippy/presentation.pdf'
import presentationSwoon from '~/assets/swoon/presentation.pdf'
import Arrow from '~/components/arrow.astro'
import Heading3 from '~/components/heading3.astro'
import Jump from '~/components/jump.astro'
import Picture from '~/components/picture.astro'
import { collectionList } from '~/utils/constants.ts'

interface Props {
  explore?: boolean
  hideFourth?: boolean
  jumpLinks?: boolean
  noTitleMarginTop?: boolean
  posts: Array<{
    data: {
      cover: {
        height: number
        src: string
        width: number
      }
      title: string
    }
    id: string
  }>
  showTitle?: boolean
  title: (typeof collectionList)[number]['name']
}

const {
  explore,
  hideFourth,
  jumpLinks,
  noTitleMarginTop,
  posts,
  showTitle,
  title
} = Astro.props

const collectionIndex = collectionList.findIndex(
  (collectionsEntry) => collectionsEntry.name === title
)

const collection = collectionList[
  collectionIndex
] as (typeof collectionList)[number]

const presentationIdRelations = [
  {
    presentation: presentationSkippy,
    id: 'skippy'
  },
  {
    presentation: presentationSwoon,
    id: 'swoon'
  }
]

function findPresentation(id: string): string | undefined {
  const findById = presentationIdRelations.find(
    (presentation) => presentation.id === id
  )
  if (findById) {
    return findById.presentation
  }
  return
}
---

{
  showTitle &&
  <Heading3 noMarginTop={Boolean(noTitleMarginTop)} text={title}/>
}
<div class="grid grid-cols-1 lg:grid-cols-3 sm:grid-cols-2 overflow-hidden">
  {
    posts.map((post, index) => (
      <a class="group pos-relative overflow-hidden" class:list={[{'hidden md:block lg:hidden': hideFourth && index === 3}]} href={collection.slug === 'presentations' ? findPresentation(post.id) : `/work/${collection.slug}/${post.id}/`}>
        <Picture alt={`cover art for ${post.data.title}`} height={post.data.cover.height} src={post.data.cover.src} width={post.data.cover.width}/>
        <h4 class="bg-dark-900/75 box-border flex font-400 h-full items-center justify-center left-0 m-0 opacity-0 group-hover:opacity-100 p-3 pos-absolute text-8 top-0 text-center text-light-500 transition-duration-500 transition-opacity w-full">{post.data.title}</h4>
      </a>
    ))
  }
</div>
{
  explore &&
  <Arrow href={`/work/${collection.slug}/`}/>
}
{
  jumpLinks &&
  (
    collectionIndex === 0 ?
    <Jump entries={[collectionList[4], collectionList[1]]}/> :
      collectionIndex === 1 ?
      <Jump entries={[collectionList[0], collectionList[2]]}/> :
        collectionIndex === 2 ?
        <Jump entries={[collectionList[1], collectionList[3]]}/> :
          collectionIndex === 3 ?
          <Jump entries={[collectionList[2], collectionList[4]]}/> :
          <Jump entries={[collectionList[3], collectionList[0]]}/>
  )
}
