---
import presentationSkippy from '~/assets/skippy/presentation.pdf'
import presentationSwoon from '~/assets/swoon/presentation.pdf'
import Picture from '~/components/astro/picture.astro'
import Icon from '~/components/svelte/icon.svelte'

interface Props {
  explore?: boolean
  posts: Array<{
    data: {
      cover: {
        height: number
        src: string
        width: number
      }
      title: string
    }
    slug: string
  }>
  title: string
}

const { explore = false, posts = [], title } = Astro.props

const collection = title.toLowerCase()

const presentationSlugRelations = [
  {
    presentation: presentationSkippy,
    slug: 'skippy'
  },
  {
    presentation: presentationSwoon,
    slug: 'swoon'
  }
]

let jumpLinks: string[] = []

if (title === 'Advertising') {
  jumpLinks = ['Fashion', 'Presentations']
} else if (title === 'Fashion') {
  jumpLinks = ['Advertising', 'Presentations']
} else if (title === 'Presentations') {
  jumpLinks = ['Advertising', 'Fashion']
}

function findPresentation(slug: string): string | undefined {
  const findBySlug = presentationSlugRelations.find(
    (presentation) => presentation.slug === slug
  )
  if (findBySlug) {
    return findBySlug.presentation
  }
  return
}
---

{
  explore &&
  <h3 class="font-400 m-0 m-b-4 text-8">{title}</h3>
}

<div class="border-rounded-1.5 grid grid-cols-1 lg:grid-cols-3 md:grid-cols-2 overflow-hidden">
  {
    posts.map(post => (
      <a class="group pos-relative" href={collection === 'presentations' ? findPresentation(post.slug) : `/work/${collection}/${post.slug}/`}>
        <Picture alt={`cover art for ${post.data.title}`} height={post.data.cover.height} parent={2} src={post.data.cover.src} width={post.data.cover.width}/>
        <h4 class="bg-dark-900/75 box-border flex font-400 h-full items-center justify-center left-0 m-0 opacity-0 group-hover:opacity-100 p-3 pos-absolute text-8 top-0 text-center text-light-500 transition-duration-500 transition-opacity w-full">{post.data.title}</h4>
      </a>
    ))
  }
</div>

{
  explore ?
  <a class="after:bg-current after:border-rounded-0.25 after:bottom--2 decoration-none flex gap-x-2 after:h-0.5 items-center after:left-0 m-l-auto m-t-6 pos-relative after:pos-absolute text-4 text-current md:text-6 after:transition-duration-250 after:transition-width w-fit after:w-0 after:hover:w-full" href={`/work/${collection}/`}>
    <span>Explore all</span>
    <Icon name="circle-arrow-right" size={6}/>
  </a> :
  <div class="flex justify-between m-t-6">
    {
      jumpLinks.map((link, index) => (
        <a class="after:bg-current after:border-rounded-0.25 after:bottom--2 decoration-none flex gap-x-2 after:h-0.5 items-center after:left-0 pos-relative after:pos-absolute text-4 text-current md:text-6 after:transition-duration-250 after:transition-width after:w-0 after:hover:w-full" href={`/work/${link.toLowerCase()}/`}>
          {
            index === 0 && <Icon name="circle-arrow-left" size={6}/>
          }
          <span>{link}</span>
          {
            index === 1 && <Icon name="circle-arrow-right" size={6}/>
          }
        </a>
      ))
    }
  </div>
}

