---
import presentationSkippy from '~/assets/skippy/presentation.pdf'
import presentationSwoon from '~/assets/swoon/presentation.pdf'
import Heading3 from '~/components/astro/heading3.astro'
import Jump from '~/components/astro/jump.astro'
import Picture from '~/components/astro/picture.astro'
import Icon from '~/components/svelte/icon.svelte'
import { collectionsData } from '~/utils/constants.ts'

interface Props {
  explore?: boolean
  jumpLinks?: boolean
  noTitleMarginTop?: boolean
  posts: Array<{
    data: {
      cover: {
        height: number
        src: string
        width: number
      }
      title: string
    }
    id: string
  }>
  showTitle?: boolean
  title: (typeof collectionsData)[number]['name']
}

const {
  explore = false,
  jumpLinks,
  noTitleMarginTop,
  posts = [],
  showTitle,
  title
} = Astro.props

const collectionIndex = collectionsData.findIndex(
  (collectionsEntry) => collectionsEntry.name === title
)
const collection = collectionsData[
  collectionIndex
] as (typeof collectionsData)[number]

const presentationSlugRelations = [
  {
    presentation: presentationSkippy,
    id: 'skippy'
  },
  {
    presentation: presentationSwoon,
    id: 'swoon'
  }
]

function findPresentation(id: string): string | undefined {
  const findById = presentationSlugRelations.find(
    (presentation) => presentation.id === id
  )
  if (findById) {
    return findById.presentation
  }
  return
}
---

{
  showTitle &&
  <Heading3 noMarginTop={Boolean(noTitleMarginTop)} text={title}/>
}
<div class="grid grid-cols-1 lg:grid-cols-3 sm:grid-cols-2 overflow-hidden">
  {
    posts.map((post) => (
      <a class="group pos-relative overflow-hidden" href={collection.slug === 'presentations' ? findPresentation(post.id) : `/work/${collection.slug}/${post.id}/`}>
        <Picture alt={`cover art for ${post.data.title}`} height={post.data.cover.height} src={post.data.cover.src} width={post.data.cover.width}/>
        <h4 class="bg-dark-900/75 box-border flex font-400 h-full items-center justify-center left-0 m-0 opacity-0 group-hover:opacity-100 p-3 pos-absolute text-8 top-0 text-center text-light-500 transition-duration-500 transition-opacity w-full">{post.data.title}</h4>
      </a>
    ))
  }
</div>
{
  explore &&
  <a class="after:bg-current after:border-rounded-0.25 after:bottom--2 after:content decoration-none flex gap-x-2 after:h-0.5 items-center after:left-0 m-l-auto m-t-6 pos-relative after:pos-absolute text-4 text-current md:text-6 after:transition-duration-250 after:transition-width w-fit after:w-0 after:hover:w-full" href={`/work/${collection.slug}/`}>
    <span>Explore all</span>
    <Icon name="circle-arrow-right" size={6}/>
  </a>
}
{
  jumpLinks &&
  (
    collectionIndex === 0 ?
    <Jump entries={[collectionsData[3], collectionsData[1]]}/> :
      collectionIndex === 1 ?
      <Jump entries={[collectionsData[0], collectionsData[2]]}/> :
        collectionIndex === 2 ?
        <Jump entries={[collectionsData[1], collectionsData[3]]}/> :
        <Jump entries={[collectionsData[2], collectionsData[0]]}/>
  )
}
