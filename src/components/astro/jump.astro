---
import Icon from '~/components/svelte/icon.svelte'
import type { collectionsData } from '~/utils/constants.ts'

interface Props {
  entries: (typeof collectionsData)[number][]
}

const { entries } = Astro.props
---

<div class="flex justify-between m-t-6">
  {
    entries.map((collectionsEntry, index) => (
      <a class="after:bg-current after:border-rounded-0.25 after:bottom--2 after:content decoration-none flex gap-x-2 after:h-0.5 items-center after:left-0 pos-relative after:pos-absolute text-4 text-current md:text-6 after:transition-duration-250 after:transition-width after:w-0 after:hover:w-full" href={`/work/${collectionsEntry.slug}/`}>
        {
          index === 0 && <Icon name="circle-arrow-left" size={6}/>
        }
          <span>{collectionsEntry.name}</span>
        {
          index === 1 && <Icon name="circle-arrow-right" size={6}/>
        }
      </a>
    ))
  }
</div>
