---
import Tooltip from '~/components/tooltip.astro'
import 'swiper/css'
import 'swiper/css/autoplay'
import 'swiper/css/effect-cards'
import 'swiper/css/effect-fade'

interface Props {
  center?: boolean
  effect?: 'cards' | 'fade'
  maxWidth?: string
  noNavigation?: boolean
}

const { center, effect, maxWidth, noNavigation } = Astro.props

const navButtonClass = [
  'block',
  'disabled:opacity-50',
  'disabled:pointer-none',
  'pos-absolute',
  'top-1/2',
  'transform',
  'transition-duration-250',
  'transition-opacity',
  'translate-y--1/2',
  'z-10'
]
---

<div class="pos-relative">
  {
    !noNavigation &&
    <Tooltip extraClass={navButtonClass.concat(['left-0'])} icon="circle-arrow-left" text="Previous" transparent/>
  }
  <astro-swiper class="swiper" class:list={[
    {
      'max-w-5/6 md:max-w-11/12': !maxWidth
    },
    maxWidth
  ]} data-center={center} data-effect={effect} data-navigation={!noNavigation}>
    <div class="swiper-wrapper">
      <slot/>
    </div>
  </astro-swiper>
  {
    !noNavigation &&
    <Tooltip extraClass={navButtonClass.concat(['right-0'])} icon="circle-arrow-right" text="Next" transparent/>
  }
</div>

<script>
import { AstroSwiper } from '~/utils/components/swiper.ts'
customElements.define('astro-swiper', AstroSwiper)
</script>
